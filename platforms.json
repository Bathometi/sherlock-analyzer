{
  "telegram": {
    "name": "Telegram",
    "url_template": "https://t.me/{}",
    "regexCheck": "^[a-zA-Z0-9_]{5,32}$",
    "detector": {
      "type": "text_presence",
      "value": "tgme_page_title"
    }
  },
  "reddit": {
    "name": "Reddit",
    "url_template": "https://www.reddit.com/user/{}",
    "regexCheck": "^[a-zA-Z0-9_-]{3,20}$",
    "detector": {
      "type": "text_absence",
      "value": "page_not_found"
    }
  },
  "github": {
    "name": "GitHub",
    "url_template": "https://github.com/{}",
    "regexCheck": "^[a-zA-Z0-9-]{1,39}$",
    "detector": {
      "type": "status_code",
      "value": 404
    }
  }
}
